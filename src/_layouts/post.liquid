---
layout: generic
---

{% assign previousPost = collections.articlesByTimestamp | getPreviousCollectionItem %}
{% assign nextPost = collections.articlesByTimestamp | getNextCollectionItem %}
{% include 'pretty-print.html' %}

<p>
  <strong>Posted:
  </strong>{%- if timestamp %}
  {{ timestamp | readableTimestamp }}
  {%- else %}
  {{ date | readableDate }} |
  {%- endif %} |
  <strong>Categories:</strong>
  {% for cat in categories %}
  <a href="/categories/{{ cat | slugify }}">{{ cat }}</a>
  {%- unless forloop.last %},
  {% endunless %}
  {% endfor %}
</p>
{% pageLinks %}
{{ content }}
<hr />
{%- if nextPost %}
  <a href="{{ nextPost.url }}" class="button primary">Previous: {{ nextPost.data.title }}</a>
{%- endif -%}
{%- if previousPost %}
  <a href="{{ previousPost.url }}" class="button primary">Next: {{ previousPost.data.title }}</a>
{%- endif -%}
<br /><br />
